# Copier ce fichier en .env.local et remplir avec les clés de votre projet Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : uniquement côté serveur, ne jamais l'exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJ...
